Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.well-known/ - [L]
    # The sole staging API endpoint. Symfony will handle /api/health.
    RewriteRule ^api/health$ index.php [END]
    # PHP front controller applies the opt-in environment gate and method allowlist.
    RewriteRule ^api/identity/(?:login|logout)$ index.php [END]
    RewriteRule ^api/devices(?:/pair/(?:start|approve|status)|/[1-9][0-9]*)?$ index.php [END]
    # All other API routes remain closed by default.
    RewriteRule ^api(?:/|$) - [F,END,NC]
    RewriteRule ^(?:index\.php|router\.php)$ - [F,END,NC]
    RewriteRule \.(?:php|sql|env|log|lock|json|yaml|yml)$ - [F,END,NC]
</IfModule>

<FilesMatch "^\.(?!well-known).*$">
    Require all denied
</FilesMatch>
