Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.well-known/ - [L]
    # Staging only: no API, playback relay, PHP or internal files exposed.
    RewriteRule ^api(?:/|$) - [F,L,NC]
    RewriteRule ^(?:index\.php|router\.php)$ - [F,L,NC]
    RewriteRule \.(?:php|sql|env|log|lock|json|yaml|yml)$ - [F,L,NC]
</IfModule>

<FilesMatch "^\.(?!well-known).*$">
    Require all denied
</FilesMatch>
