APP_ENV=dev
APP_DEBUG=1
APP_SECRET=replace-with-random-32-bytes
DATABASE_URL=postgresql://iptv:iptv@database:5432/iptv?charset=utf8
IPTV_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# base64 of a random 32-byte secret, e.g. php -r 'echo base64_encode(random_bytes(32)),PHP_EOL;'
IPTV_SECRET_KEY=replace-with-base64-key

# Exact allowed HTTPS hosts for remote source sync, comma-separated; no wildcards
IPTV_TRUSTED_HOSTS=

# Optional production direct-HLS playback (off by default).
# This does NOT proxy protected streams and requires account authentication.
# Add only explicit HTTPS hosts serving public/credential-free .m3u8 playlists
# that permit cross-origin playback from the NSatellite website (CORS).
IPTV_ENABLE_DIRECT_HLS=0
IPTV_PUBLIC_HLS_HOSTS=
# Hosts above must ALSO be listed in IPTV_TRUSTED_HOSTS.

# o2switch public_html release gates. Keep off until staged security review.
NELSTV_ENABLE_IDENTITY_API=0
NELSTV_ENABLE_VIEWER_API=0
# Explicit UI deployment: NSATELLITE_INSTALL_VIEWER_UI=1 bash deploy/o2switch/install-viewer.sh
