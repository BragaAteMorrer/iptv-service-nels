APP_ENV=dev
APP_DEBUG=1
APP_SECRET=replace-with-random-32-bytes
DATABASE_URL=postgresql://iptv:iptv@database:5432/iptv?charset=utf8
IPTV_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# base64 of a random 32-byte secret, e.g. php -r 'echo base64_encode(random_bytes(32)),PHP_EOL;'
IPTV_SECRET_KEY=replace-with-base64-key
